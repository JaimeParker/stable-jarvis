# ── Stable-JARVIS 统一 API 配置 ───────────────────────────────────────────────
# 复制此文件为 .env 并填入真实 key：
#   cp .env.example .env
#
# .env 已被 .gitignore 排除，不会提交到 git。

# ── LLM 提供商（paper-deep-reader 精读 + paperwise 共用）──────────────────────
# LLM_PROVIDER 可选: anthropic | openai | deepseek | qwen
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
# 各提供商 API key（按需填写）
DEEPSEEK_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# QWEN_API_KEY=sk-...

# ── Embedding（paper-deep-reader Obsidian 语义搜索 + paper-finder semantic）───
# EMBEDDING_PROVIDER 可选: qwen | openai | local
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_API_KEY=sk-your-key-here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# ── Zotero（paper-analyzer + paper-deep-reader 共用）──────────────────────────
ZOTERO_LIBRARY_ID=your_library_id
ZOTERO_API_KEY=your_api_key
ZOTERO_LIBRARY_TYPE=user

# ── Exa Search（exa-search skill）─────────────────────────────────────────────
EXA_API_KEY=your-exa-key-here
