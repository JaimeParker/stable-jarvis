      <skill upstream="everything-claude-code">continuous-learning</skill>
      <skill upstream="everything-claude-code">continuous-learning-v2</skill>
      <skill upstream="everything-claude-code">cpp-coding-standards</skill>
      <skill upstream="everything-claude-code">docker-patterns</skill>
      <skill upstream="superpowers">executing-plans</skill>
      <skill upstream="everything-claude-code">iterative-retrieval</skill>
      <skill>markdown-to-html</skill>
      <skill upstream="awesome-copilot">premium-frontend-ui</skill>
      <skill upstream="everything-claude-code">python-patterns</skill>
      <skill upstream="everything-claude-code">verification-loop</skill>
      <skill upstream="everything-claude-code">videodb</skill>
      <skill upstream="awesome-copilot">web-coder</skill>
      <skill upstream="superpowers">writing-plans</skill>
    </skills>
    <agents>
      <agent>architect.md</agent>
