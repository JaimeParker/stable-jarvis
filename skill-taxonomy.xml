<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stable-JARVIS Skill Taxonomy
  Centralized classification for skills, agents, and commands.
  Read by install.sh, install_mac.sh, install.windows.ps1, and sync-upstream.sh.

  To reclassify a skill, just move its <skill> element to another category.
  To add a skill, add a <skill> element and a description in the install scripts.

  upstream="repo-name"  → skill sourced from an upstream repo; sync-upstream.sh
                           replaces it with a symlink to upstream/<repo-name>/.
  path="sub/path"       → (optional) subdirectory within the upstream repo where
                           the skill lives. Defaults to "skills".
-->
<taxonomy>
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- RESEARCH (科研): academic toolchain — papers, notes, literature -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <category id="RESEARCH" cn="科研">
    <skills>
      <skill upstream="deepagents" path="libs/cli/examples/skills">arxiv-search</skill>
      <skill upstream="everything-claude-code">exa-search</skill>
      <skill>markitdown-convert</skill>
      <skill>notion-to-markdown</skill>
      <skill>obsidian-auto-classifier</skill>
      <skill>obsidian-batch-yaml</skill>
      <skill upstream="obsidian-skills">obsidian-markdown</skill>
      <skill>paper-analyzer</skill>
      <skill>paper-code-audit</skill>
      <skill>paper-deep-reader</skill>
      <skill>paper-finder</skill>
      <skill upstream="deepagents" path="libs/cli/examples/skills">web-research</skill>
    </skills>
    <agents>
      <agent>doc-updater.md</agent>
    </agents>
    <commands>
      <command>paper/analyze.toml</command>
    </commands>
  </category>

  <!-- ═══════════════════════════════════════════════════════════════ -->
